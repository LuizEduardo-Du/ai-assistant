# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).

# Chave da API da Anthropic (https://console.anthropic.com).
# Deixe vazia para rodar em "modo demonstração", sem IA real.
ANTHROPIC_API_KEY=

# Modelo de IA usado nas respostas.
AI_MODEL=claude-opus-5-5

# Esforço de raciocínio: low, medium, high, xhigh ou max.
AI_EFFORT=low
